# Copy this file to `.env` and fill in the real values.
# `.env` is gitignored. Never commit real keys.

# Supabase project URL.
# Find it in the Supabase dashboard: Project Settings > API > Project URL.
SUPABASE_URL=https://xgvuavikubqwsdhoadyw.supabase.co

# Supabase anon (public) key. Safe for the browser, protected by RLS.
# Find it in the Supabase dashboard: Project Settings > API > Project API keys > anon public.
SUPABASE_ANON_KEY=your-anon-key-here

# Vite exposes only variables that start with VITE_ to client code.
# Keep these the same values as above.
VITE_SUPABASE_URL=https://xgvuavikubqwsdhoadyw.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only. NEVER expose this to the browser and NEVER commit it.
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
