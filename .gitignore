# --- Dependencies ---
node_modules/
.pnp
.pnp.js
.yarn/cache/
.yarn/install-state.gz

# --- Environment / secrets ---
.env
.env.*
!.env.example
*.pem
*.key

# --- Build output ---
dist/
build/
out/
.output/
.vite/
.parcel-cache/
*.tsbuildinfo

# --- Symbols (symbo.ls) local state ---
# .symbols_local/config.json IS tracked; everything else in it is local state.
.symbols_local/*
!.symbols_local/config.json
.symbols_local/lock.json
.symbols_local/project.json
.symbols_local/libs/
.symbols_local/snapshots/

# --- Supabase ---
# Local CLI state: linked project ref, versions, pooler URL.
supabase/.temp/
supabase/.branches/
.branches/

# --- Logs and caches ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.npm
.eslintcache
coverage/
.cache/

# --- Editor / OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
*.swp

# Media source files — large binaries, distributed out-of-band (see docs/architecture.md §4)
videos/
*.mov
*.mp4
